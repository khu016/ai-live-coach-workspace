MODEL_PROVIDER=deepseek
MODEL_NAME=deepseek-chat
MODEL_API_KEY=
MODEL_BASE_URL=https://api.deepseek.com/v1

# 实时 ASR（第一版主 ASR，驱动动态弹幕）：tencent_realtime | mock
ASR_PROVIDER=mock
TENCENT_ASR_APPID=
TENCENT_ASR_SECRET_ID=
TENCENT_ASR_SECRET_KEY=
TENCENT_ASR_ENGINE_MODEL=16k_zh
TENCENT_ASR_VOICE_FORMAT=1

# 动态弹幕（统一调度：语音驱动 + 环境/刁难弹幕）
BULLET_DENSITY_MODE=normal
BULLET_INTERVAL_MIN_SEC=3
BULLET_INTERVAL_MAX_SEC=6
BULLET_BURST_MAX=3
# 环境弹幕：首条 8–12 秒，之后每 3–6 秒
BULLET_AMBIENT_FIRST_MIN_SEC=8
BULLET_AMBIENT_FIRST_MAX_SEC=12
# 刁难弹幕：首条 15–20 秒，之后每 20–40 秒
BULLET_ADVERSARIAL_FIRST_MIN_SEC=15
BULLET_ADVERSARIAL_FIRST_MAX_SEC=20
BULLET_ADVERSARIAL_MIN_SEC=20
BULLET_ADVERSARIAL_MAX_SEC=40
BULLET_COLD_START_SEC=15
BULLET_GENERATE_TIMEOUT_SEC=8
# 旧配置 BULLET_MIN_INTERVAL_SEC 已废弃，保留可覆盖语音驱动弹幕的最小间隔；
# 不设置时默认对齐 BULLET_INTERVAL_MIN_SEC。

# 讯飞录音文件转写（暂不启用，字段保留备以后兜底）
ASR_APP_ID=
ASR_SECRET_KEY=

DATA_DIR=data
RECORDING_MAX_MB=1024
PRACTICE_MAX_SEC=1200
