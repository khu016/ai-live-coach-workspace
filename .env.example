MODEL_PROVIDER=deepseek
MODEL_NAME=deepseek-chat
MODEL_API_KEY=
MODEL_BASE_URL=https://api.deepseek.com/v1

# 实时 ASR（第一版主 ASR，驱动动态弹幕）：tencent_realtime | mock
ASR_PROVIDER=mock
TENCENT_ASR_APPID=
TENCENT_ASR_SECRET_ID=
TENCENT_ASR_SECRET_KEY=
TENCENT_ASR_ENGINE_MODEL=16k_zh
TENCENT_ASR_VOICE_FORMAT=1

# 动态弹幕
BULLET_MIN_INTERVAL_SEC=5
BULLET_COLD_START_SEC=15
BULLET_GENERATE_TIMEOUT_SEC=8

# 讯飞录音文件转写（暂不启用，字段保留备以后兜底）
ASR_APP_ID=
ASR_SECRET_KEY=

DATA_DIR=data
RECORDING_MAX_MB=1024
PRACTICE_MAX_SEC=1200
